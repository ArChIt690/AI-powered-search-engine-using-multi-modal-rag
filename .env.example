ES_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0
# LLMs: both are used together; each falls back to the other on an error or rate limit.
# Free keys: console.groq.com and aistudio.google.com. With only one key, that provider does everything.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MCP servers the LLM can use, as JSON (none by default). Example:
# MCP_SERVERS={"files": {"transport": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "docs"]}}

# Tailscale (docker compose --profile tailscale up -d): a tagged auth key, and who may use the admin page
# TS_AUTHKEY=tskey-auth-...
# SEARCH_ADMINS=you@example.com

# Where the frontend finds the API (default http://localhost:8000)
# API_URL=http://localhost:8000

# Optional overrides (defaults in src/search_engine/core/config.py)
# ES_TEXT_INDEX=search_chunks_text
# ES_IMAGE_INDEX=search_chunks_images
# INDEX_VERSION_KEY=search:index_version
