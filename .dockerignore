# What the API image's build never needs (keeps the build context small and secrets out of images).

# Secrets: the API container reads .env at start (env_file in docker-compose.yml); it is never copied in
.env

# Virtual environments and Python caches
.venv
__pycache__/
*.py[oc]
.pytest_cache/
*.egg-info
build/
dist/

# Version control and editor files
.git
.gitignore
.vscode/
.idea/
*.bkp

# Runtime data (mounted as a volume, not baked into the image)
data/

# Not part of the API: the frontend has its own image; tests, docs, plans and the benchmark run on the host
frontend/
tests/
docs/
Prompts/
eval/
Dockerfile
docker-compose.yml
